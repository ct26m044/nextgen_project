
{
  "name": "PixelFlow",
  "version": "1.1.0",
  "themes": {
    "light": {
      "color": {
        "primitive": {
          "navy": {
            "900": "#101C2C",
            "800": "#172A3F",
            "700": "#243B53"
          },
          "blue": {
            "700": "#1D4ED8",
            "600": "#2563EB",
            "500": "#3B82F6"
          },
          "turquoise": {
            "700": "#0E7490",
            "600": "#0891B2",
            "500": "#06B6D4"
          },
          "mint": {
            "700": "#047857",
            "600": "#059669",
            "500": "#34D399"
          },
          "gray": {
            "900": "#111827",
            "700": "#374151",
            "500": "#6B7280",
            "300": "#D1D5DB",
            "200": "#E5E7EB",
            "100": "#F3F4F6",
            "50": "#F9FAFB"
          },
          "white": "#FFFFFF",
          "black": "#000000"
        },
        "semantic": {
          "color-background": "{color.primitive.gray.50}",
          "color-surface": "{color.primitive.white}",
          "color-surface-raised": "{color.primitive.white}",
          "color-surface-muted": "{color.primitive.gray.100}",

          "color-text-primary": "{color.primitive.navy.900}",
          "color-text-secondary": "{color.primitive.gray.700}",
          "color-text-muted": "{color.primitive.gray.500}",
          "color-text-inverse": "{color.primitive.white}",

          "color-border": "{color.primitive.gray.200}",
          "color-border-strong": "{color.primitive.gray.300}",

          "color-action-primary": "{color.primitive.blue.600}",
          "color-action-primary-hover": "{color.primitive.blue.700}",
          "color-action-primary-text": "{color.primitive.white}",

          "color-accent": "{color.primitive.turquoise.500}",
          "color-accent-hover": "{color.primitive.turquoise.600}",
          "color-accent-subtle": "{color.primitive.turquoise.500}",

          "color-selection": "{color.primitive.mint.500}",
          "color-selection-text": "{color.primitive.navy.900}",

          "color-focus-ring": "{color.primitive.blue.500}",
          "color-icon-primary": "{color.primitive.navy.900}",
          "color-icon-secondary": "{color.primitive.gray.500}"
        }
      }
    },
    "dark": {
      "color": {
        "primitive": {},
        "semantic": {}
      }
    }
  },
  "spacing": {
    "primitive": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px"
    },
    "semantic": {
      "space-inline-xs": "{spacing.primitive.1}",
      "space-inline-sm": "{spacing.primitive.2}",
      "space-inline-md": "{spacing.primitive.3}",
      "space-inline-lg": "{spacing.primitive.4}",

      "space-stack-xs": "{spacing.primitive.2}",
      "space-stack-sm": "{spacing.primitive.3}",
      "space-stack-md": "{spacing.primitive.4}",
      "space-stack-lg": "{spacing.primitive.6}",

      "space-card-padding": "{spacing.primitive.6}",
      "space-section-gap": "{spacing.primitive.10}",
      "space-page-gutter": "{spacing.primitive.6}",
      "space-layout-max-gap": "{spacing.primitive.12}"
    }
  },
  "typography": {
    "primitive": {
      "font-family": {
        "sans": "Inter, system-ui, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, monospace"
      },
      "font-size": {
        "xs": "12px",
        "sm": "14px",
        "md": "16px",
        "lg": "18px",
        "xl": "20px",
        "2xl": "24px",
        "3xl": "30px",
        "4xl": "36px",
        "5xl": "48px"
      },
      "font-weight": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "line-height": {
        "tight": 1.2,
        "normal": 1.5,
        "relaxed": 1.75
      },
      "letter-spacing": {
        "tight": "-0.02em",
        "normal": "0em",
        "wide": "0.04em"
      }
    },
    "semantic": {
      "text-display": {
        "font-family": "{typography.primitive.font-family.sans}",
        "font-size": "{typography.primitive.font-size.5xl}",
        "font-weight": "{typography.primitive.font-weight.bold}",
        "line-height": "{typography.primitive.line-height.tight}",
        "letter-spacing": "{typography.primitive.letter-spacing.tight}"
      },
      "text-h1": {
        "font-family": "{typography.primitive.font-family.sans}",
        "font-size": "{typography.primitive.font-size.4xl}",
        "font-weight": "{typography.primitive.font-weight.bold}",
        "line-height": "{typography.primitive.line-height.tight}"
      },
      "text-h2": {
        "font-family": "{typography.primitive.font-family.sans}",
        "font-size": "{typography.primitive.font-size.3xl}",
        "font-weight": "{typography.primitive.font-weight.semibold}",
        "line-height": "{typography.primitive.line-height.tight}"
      },
      "text-h3": {
        "font-family": "{typography.primitive.font-family.sans}",
        "font-size": "{typography.primitive.font-size.2xl}",
        "font-weight": "{typography.primitive.font-weight.semibold}",
        "line-height": "{typography.primitive.line-height.normal}"
      },
      "text-body": {
        "font-family": "{typography.primitive.font-family.sans}",
        "font-size": "{typography.primitive.font-size.md}",
        "font-weight": "{typography.primitive.font-weight.regular}",
        "line-height": "{typography.primitive.line-height.normal}"
      },
      "text-body-small": {
        "font-family": "{typography.primitive.font-family.sans}",
        "font-size": "{typography.primitive.font-size.sm}",
        "font-weight": "{typography.primitive.font-weight.regular}",
        "line-height": "{typography.primitive.line-height.normal}"
      },
      "text-label": {
        "font-family": "{typography.primitive.font-family.sans}",
        "font-size": "{typography.primitive.font-size.sm}",
        "font-weight": "{typography.primitive.font-weight.medium}",
        "line-height": "{typography.primitive.line-height.normal}"
      },
      "text-caption": {
        "font-family": "{typography.primitive.font-family.sans}",
        "font-size": "{typography.primitive.font-size.xs}",
        "font-weight": "{typography.primitive.font-weight.regular}",
        "line-height": "{typography.primitive.line-height.normal}"
      },
      "text-button": {
        "font-family": "{typography.primitive.font-family.sans}",
        "font-size": "{typography.primitive.font-size.md}",
        "font-weight": "{typography.primitive.font-weight.semibold}",
        "line-height": "{typography.primitive.line-height.normal}"
      }
    }
  },
  "components": {
    "button-primary": {
      "background": "{color.semantic.color-action-primary}",
      "background-hover": "{color.semantic.color-action-primary-hover}",
      "text": "{color.semantic.color-action-primary-text}",
      "typography": "{typography.semantic.text-button}",
      "padding-inline": "{spacing.primitive.4}",
      "padding-block": "{spacing.primitive.3}"
    },
    "session-card": {
      "background": "{color.semantic.color-surface}",
      "text": "{color.semantic.color-text-primary}",
      "border": "{color.semantic.color-border}",
      "padding": "{spacing.semantic.space-card-padding}",
      "title-typography": "{typography.semantic.text-h3}",
      "body-typography": "{typography.semantic.text-body}",
      "meta-typography": "{typography.semantic.text-caption}"
    },
    "filter-selected": {
      "background": "{color.semantic.color-selection}",
      "text": "{color.semantic.color-selection-text}",
      "typography": "{typography.semantic.text-label}",
      "padding-inline": "{spacing.primitive.3}",
      "padding-block": "{spacing.primitive.2}"
    }
  }
}
